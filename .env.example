# ─────────────────────────────────────────────────────────────────────────────
#  KAC Academy — environment variables.  Copy to .env.local and fill in.
#  With NOTHING set, `npm run dev` runs on an embedded demo database (.data/).
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string. For Supabase use the *Transaction pooler* URI
# (Project Settings → Database → Connection string → Transaction pooler, port 6543).
# Leave blank for the embedded demo database (local use only, never on Vercel).
DATABASE_URL=

# Signs student and admin session cookies. REQUIRED in production.
# Generate one:  openssl rand -base64 48
SESSION_SECRET=

# Supabase project (Project Settings → API). Used for photo storage (server)
# and the optional instant "live" channel (browser). All optional locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never commit.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=photos

# Public URL of the deployed app, used in QR codes / login links.
# Optional: falls back to the request host.
APP_URL=
